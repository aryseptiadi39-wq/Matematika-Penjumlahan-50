    <!-- JAVASCRIPT LOGIC -->
    <script>
        // Tab Navigation Management
        const tabs = ['beranda', 'tujuan', 'puluhan', 'penjumlahan', 'permainan', 'makanan', 'latihan', 'kuis', 'hasil'];
        
        function switchTab(tabId) {
            tabs.forEach(t => {
                const el = document.getElementById(`tab-${t}`);
                if (el) el.classList.add('hidden');
            });
            const target = document.getElementById(`tab-${tabId}`);
            if (target) {
                target.classList.remove('hidden');
                window.scrollTo({ top: 0, behavior: 'smooth' });
            }

            // Update Nav Active State
            document.querySelectorAll('.nav-btn').forEach(btn => {
                if (btn.getAttribute('data-tab') === tabId) {
                    btn.className = "nav-btn px-3 py-1.5 rounded-xl font-semibold text-xs md:text-sm bg-emerald-500 text-white shadow transition transform active:scale-95 flex items-center gap-1.5";
                } else {
                    btn.className = "nav-btn px-3 py-1.5 rounded-xl font-semibold text-xs md:text-sm bg-slate-100 text-slate-600 hover:bg-emerald-100 hover:text-emerald-700 transition transform active:scale-95 flex items-center gap-1.5";
                }
            });

            // Update Progress Bar
            const index = tabs.indexOf(tabId);
            const percent = Math.round(((index + 1) / tabs.length) * 100);
            const progressBar = document.getElementById('global-progress');
            if (progressBar) progressBar.style.width = percent + '%';

            // Unlock Badges based on progress
            if (tabId === 'puluhan') unlockBadge('badge-1');
            if (tabId === 'permainan') unlockBadge('badge-2');
            if (tabId === 'makanan') unlockBadge('badge-3');
            if (tabId === 'kuis' || tabId === 'hasil') unlockBadge('badge-4');
            updateStatDisplay();
        }

        function unlockBadge(badgeId) {
            const b = document.getElementById(badgeId);
            if (b) {
                b.classList.remove('opacity-60', 'bg-slate-100');
                b.classList.add('bg-amber-50', 'border-amber-300', 'shadow-md', 'animate-pulse-scale');
            }
        }

        // Kegiatan 1 Quiz Puluhan & Satuan
        function checkPuluhanQuiz() {
            const p = document.getElementById('pq-ans-p').value.trim();
            const s = document.getElementById('pq-ans-s').value.trim();
            const fb = document.getElementById('pq-feedback');
            if (p === '3' && s === '4') {
                fb.innerHTML = '<span class="text-emerald-600">Hebat! Kamu sudah menemukan nilai tempat dengan tepat! ⭐</span>';
            } else {
                fb.innerHTML = '<span class="text-rose-600">Coba lagi. Ingat, 1 puluhan terdiri dari 10 satuan. Bilangan 34 adalah 3 puluhan dan 4 satuan!</span>';
            }
        }

        // Kegiatan 2 Step Example Viewer
        function showStepExample(title, num1, num2, result) {
            const box = document.getElementById('example-detail-box');
            const t = document.getElementById('ex-title');
            const d = document.getElementById('ex-desc');
            box.classList.remove('hidden');
            t.innerText = `Penyelesaian: ${title}`;
            
            // Extract units and tens
