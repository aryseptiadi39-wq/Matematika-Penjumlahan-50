        let activeKuisQuestions = [];

        function initKuis() {
            activeKuisQuestions = [];
            const container = document.getElementById('kuis-questions-container');
            container.innerHTML = '';

            kuisBank.forEach((variations, index) => {
                // Pilih 1 variasi secara acak dari 10 variasi
                const randomVar = variations[Math.floor(Math.random() * variations.length)];
                activeKuisQuestions.push(randomVar);

                const card = document.createElement('div');
                card.className = "bg-slate-50 p-5 rounded-2xl border border-slate-200 shadow-sm";
                
                let inputHtml = '';
                if (randomVar.type === 'fill2') {
                    inputHtml = `
                        <div class="flex items-center gap-2 mt-3">
                            <input type="number" id="kuis-p-${index}" class="w-16 p-2 rounded-xl border border-slate-300 text-center font-bold" placeholder="Puluhan"> puluhan & 
                            <input type="number" id="kuis-s-${index}" class="w-16 p-2 rounded-xl border border-slate-300 text-center font-bold" placeholder="Satuan"> satuan
                        </div>
                    `;
                } else if (randomVar.type === 'mc') {
                    const shuffledOpts = [...randomVar.options].sort(() => Math.random() - 0.5);
                    inputHtml = `<div class="grid grid-cols-1 sm:grid-cols-2 gap-2 mt-3">`;
                    shuffledOpts.forEach(opt => {
                        inputHtml += `
                            <label class="flex items-center gap-2 bg-white p-3 rounded-xl border border-slate-200 cursor-pointer hover:bg-amber-50 transition">
                                <input type="radio" name="kuis-${index}" value="${opt}" class="text-amber-600">
                                <span class="font-bold text-slate-800 text-sm">${opt}</span>
                            </label>
                        `;
                    });
                    inputHtml += `</div>`;
                } else {
                    inputHtml = `
                        <div class="mt-3">
                            <input type="number" id="kuis-single-${index}" class="w-32 p-2 rounded-xl border border-slate-300 font-bold text-center text-lg" placeholder="Jawaban">
                        </div>
                    `;
                }

                card.innerHTML = `
                    <div class="font-bold text-slate-800 text-sm md:text-base mb-2">Soal Kuis ${index + 1}: ${randomVar.q}</div>
                    ${inputHtml}
                `;
                container.appendChild(card);
            });

            document.getElementById('kuis-result-box').classList.add('hidden');
        }

        function submitKuis() {
            let correctCount = 0;
            activeKuisQuestions.forEach((item, index) => {
                let userCorrect = false;
                if (item.type === 'fill2') {
                    const p = parseInt(document.getElementById(`kuis-p-${index}`).value);
                    const s = parseInt(document.getElementById(`kuis-s-${index}`).value);
                    if (p === item.ansP && s === item.ansS) userCorrect = true;
                } else if (item.type === 'mc') {
                    const selected = document.querySelector(`input[name="kuis-${index}"]:checked`);
                    if (selected && selected.value.toString().trim() === item.ans.toString().trim()) userCorrect = true;
                } else {
                    const val = parseInt(document.getElementById(`kuis-single-${index}`).value);
                    if (val === item.ans) userCorrect = true;
                }
                if (userCorrect) correctCount++;
            });

            const score = correctCount * 10;
            const resBox = document.getElementById('kuis-result-box');
            resBox.classList.remove('hidden');
            document.getElementById('kuis-score-display').innerText = `Skor Kamu: ${score} dari 100 (${correctCount} Benar dari 10 Soal)`;
            
            let msg = "";
            let badgeHtml = "";
            if (score >= 90) {
                msg = "Luar biasa! Kamu sangat hebat! 🌟";
                badgeHtml = '<div class="text-4xl animate-bounce-gentle">🏆</div>';
            } else if (score >= 70) {
                msg = "Hebat! Terus berlatih! ⭐";
                badgeHtml = '<div class="text-4xl animate-bounce-gentle">⭐</div>';
            } else if (score >= 50) {
                msg = "Bagus! Yuk, belajar lagi! 💪";
                badgeHtml = '<div class="text-4xl animate-bounce-gentle">💪</div>';
            } else {
                msg = "Tidak apa-apa. Ayo coba lagi! 😊";
                badgeHtml = '<div class="text-4xl animate-bounce-gentle">😊</div>';
            }
            document.getElementById('kuis-feedback-msg').innerText = msg;
            document.getElementById('badge-container').innerHTML = badgeHtml;

            // update stat
            document.getElementById('stat-kuis-score').innerText = `${score}/100`;
        }

        function updateStatDisplay() {
            document.getElementById('stat-game-score').innerText = `${gameScore} ⭐`;
        }

